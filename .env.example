# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real values to this file or to .env.

# Immersal developer API key (https://developers.immersal.com). Used to load
# the venue's Immersal map for indoor visual positioning.
IMMERSAL_API_KEY=

# Numeric ID of the Immersal map for the venue being served.
IMMERSAL_MAP_ID=

# URL (or path) of the venue JSON supplied by the venue operator, which
# defines the points of interest shown in the app.
VENUE_JSON_URL=

# Which positioning provider to use: immersal, qr or mock. Leave empty to use
# the venue's own providers.order (or the default: immersal, then qr).
POSITIONING_PROVIDER=
